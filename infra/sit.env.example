# ProGenie SIT server settings. Don't edit this template with real values.
# On the server run:  ./scripts/sit-secrets.sh <sit-domain> <your-email>
# It copies this file to .env.sit (git-ignored, readable only by you) and fills every secret with a fresh random value.

# ---------------------------------------------------------------- server
# Public host name with DNS pointing at the server, e.g. sit.progenie.in, or 13-233-10-20.sslip.io (free, no DNS setup)
SIT_DOMAIN=
# Let's Encrypt sends certificate expiry notices here
ACME_EMAIL=

# ---------------------------------------------------------------- database (Postgres runs in Docker on the same server)
POSTGRES_DB=progenie
POSTGRES_USER=progenie
POSTGRES_PASSWORD=
# The ProGenieV2-Database clone, relative to this infra/ folder
PROGENIE_DB_DIR=../../ProGenieV2-Database

# ---------------------------------------------------------------- secrets (generated)
PROGENIE_OTP_PEPPER=
PROGENIE_PAYMENT_WEBHOOK_SECRET=
# base64 of the PEM files
PROGENIE_JWT_PRIVATE_KEY=
PROGENIE_JWT_PUBLIC_KEY=

# Mailpit inbox at https://SIT_DOMAIN/mailpit (testers read one-time codes there)
MAILPIT_USER=tester
# bcrypt hash of the password (the script prints the password once)
MAILPIT_PASSWORD_HASH=

# ---------------------------------------------------------------- messages
# mailpit: every SMS / WhatsApp / email lands in the Mailpit inbox above (recommended for SIT)
PROGENIE_SMS_PROVIDER=mailpit
PROGENIE_WHATSAPP_PROVIDER=mailpit
PROGENIE_EMAIL_PROVIDER=mailpit
PROGENIE_MAIL_FROM=no-reply@progenie.in
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_WHATSAPP_NUMBER=
MSG91_EMAIL_DOMAIN=
MSG91_WEBHOOK_TOKEN=

# ---------------------------------------------------------------- payments
# fake (default) or razorpay with TEST keys only (rzp_test_...). The API refuses live keys outside prod.
PROGENIE_PAYMENT_GATEWAY=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PROGENIE_TAX_GST_ENABLED=false
PROGENIE_TAX_GSTIN=
PROGENIE_TAX_SAC=
PROGENIE_TAX_RATE=18

# ---------------------------------------------------------------- company (receipts, legal pages)
PROGENIE_COMPANY_LEGAL_NAME=
PROGENIE_COMPANY_ADDRESS=
PROGENIE_COMPANY_CITY=Ahmedabad
PROGENIE_SUPPORT_EMAIL=support@progenie.in
PROGENIE_SUPPORT_PHONE=
PROGENIE_COMPANY_GRIEVANCE_NAME=
PROGENIE_COMPANY_GRIEVANCE_EMAIL=grievance@progenie.in
