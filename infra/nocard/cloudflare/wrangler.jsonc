// Cloudflare Workers settings for the ProGenie front end (free plan, no card). See docs/DEPLOYMENT_NOCARD.md.
// Deploy with infra/nocard/scripts/deploy-web.sh: it builds the Angular app first and passes BACKEND_URL.
{
  "name": "progenie",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  // The site's address: https://progenie.<your-subdomain>.workers.dev
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    // The Angular production build (paths here are relative to this file)
    "directory": "../../../web/dist/web/browser",
    "binding": "ASSETS",
    // Unknown paths such as /bookings/42 get index.html, so the Angular router handles them
    "not_found_handling": "single-page-application",
    // Only these paths run worker.js; everything else is a static file (free and doesn't count as a request)
    "run_worker_first": ["/api/*", "/mailpit", "/mailpit/*"]
  },
  "observability": { "enabled": true }
}
