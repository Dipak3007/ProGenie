# Caddy in front of the SIT stack. Used by compose.sit.yaml; values come from infra/.env.sit.
#   Server mode (default): SITE_ADDRESS is the public host name, so Caddy gets a Let's Encrypt certificate
#                          and serves HTTPS on 80/443.
#   Tunnel mode (compose.tunnel.yaml): SITE_ADDRESS is ":80". Cloudflare terminates HTTPS and cloudflared
#                          forwards plain HTTP here, so the tunnel is trusted for the client's real IP.
{
	email {$ACME_EMAIL}
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Mailpit inbox for testers (SMS / WhatsApp / email copies with one-time codes), password protected
	@mailpit path /mailpit /mailpit/*
	handle @mailpit {
		basic_auth {
			{$MAILPIT_USER} {$MAILPIT_PASSWORD_HASH}
		}
		reverse_proxy mailpit:8025
	}

	# Everything else: the web container (Angular app, and /api proxied to Spring Boot)
	handle {
		reverse_proxy web:80
	}
}
