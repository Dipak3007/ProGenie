# Copy to .env (same folder) and adjust. .env is git-ignored; never commit real secrets.
# For the SIT server use sit.env.example and scripts/sit-secrets.sh instead (see docs/DEPLOYMENT.md).

POSTGRES_DB=progenie
POSTGRES_USER=progenie
POSTGRES_PASSWORD=progenie
POSTGRES_PORT=5432

REDIS_PORT=6379

WEB_PORT=8088

# Where the database scripts folder lives, relative to this infra/ folder
PROGENIE_DB_DIR=../../ProGenieV2-Database

# Optional: base64 of PEM files so logins survive API restarts (see docs/LOCAL_SETUP.md §9)
PROGENIE_JWT_PRIVATE_KEY=
PROGENIE_JWT_PUBLIC_KEY=

# Secret shared with the payment gateway to sign callbacks and webhooks (any long random string locally)
PROGENIE_PAYMENT_WEBHOOK_SECRET=local-dev-webhook-secret

# ---------------------------------------------------------------- accounts
# HMAC key for one-time codes. Any long random string; required in production (openssl rand -hex 32)
PROGENIE_OTP_PEPPER=local-dev-otp-pepper-change-me

# ---------------------------------------------------------------- messages
# mailpit (default): every SMS, WhatsApp and email shows up at http://localhost:8025
# msg91: live delivery; needs the MSG91 account below and a template per message in application.yml
PROGENIE_SMS_PROVIDER=mailpit
PROGENIE_WHATSAPP_PROVIDER=mailpit
PROGENIE_EMAIL_PROVIDER=mailpit
PROGENIE_MAIL_FROM=no-reply@progenie.in
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_WHATSAPP_NUMBER=
MSG91_EMAIL_DOMAIN=
# Secret for the delivery-report URL: /api/v1/webhooks/msg91/delivery?token=<this>
MSG91_WEBHOOK_TOKEN=

# ---------------------------------------------------------------- payments
# fake (default) or razorpay. Test keys start with rzp_test_. Never commit real keys.
PROGENIE_PAYMENT_GATEWAY=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# GST: leave off until you are registered; then receipts become tax invoices
PROGENIE_TAX_GST_ENABLED=false
PROGENIE_TAX_GSTIN=
PROGENIE_TAX_SAC=
PROGENIE_TAX_RATE=18

# ---------------------------------------------------------------- company (receipts, legal pages)
PROGENIE_COMPANY_LEGAL_NAME=
PROGENIE_COMPANY_ADDRESS=
PROGENIE_COMPANY_CITY=Ahmedabad
PROGENIE_SUPPORT_EMAIL=support@progenie.in
PROGENIE_SUPPORT_PHONE=
PROGENIE_COMPANY_GRIEVANCE_NAME=
PROGENIE_COMPANY_GRIEVANCE_EMAIL=grievance@progenie.in
